---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import groundGrass from '../assets/island/ground-grass.png';
import palm from '../assets/island/palm.png';
import oak from '../assets/island/oak.png';
import bush from '../assets/island/bush.png';
import rock from '../assets/island/rock.png';
import sign from '../assets/island/sign.png';
import flowerYellow from '../assets/island/flower-yellow.png';
import flowerRed from '../assets/island/flower-red.png';
import miiApartments from '../assets/island/mii-apartments.png';
import townHall from '../assets/island/town-hall.png';
import concertHall from '../assets/island/concert-hall.png';
import cloudLarge from '../assets/island/cloud-large.png';
import cloudSmall from '../assets/island/cloud-small.png';
import sun from '../assets/island/sun.png';

interface Props {
	profilePhoto: ImageMetadata;
	githubPath: string;
}

const { profilePhoto, githubPath } = Astro.props;
---

<section class="island-hero" aria-labelledby="island-title">
	<header class="island-header">
		<div class="name-plaque">
			<span class="plaque-icon" aria-hidden="true">●</span>
			<div>
				<h1 id="island-title">Vishwas Parpattegar</h1>
				<p>Vishwas Island · Personal broadcast</p>
			</div>
		</div>

	</header>

	<div class="island-scene">
		<Image class="sky-asset sun-asset" src={sun} alt="" aria-hidden="true" />
		<Image class="sky-asset cloud-large" src={cloudLarge} alt="" aria-hidden="true" />
		<Image class="sky-asset cloud-small" src={cloudSmall} alt="" aria-hidden="true" />

		<div class="island-map" aria-hidden="true">
			<div class="island-shadow"></div>
			<Image class="terrain tile-one" src={groundGrass} alt="" />
			<Image class="terrain tile-two" src={groundGrass} alt="" />
			<Image class="terrain tile-three" src={groundGrass} alt="" />
			<Image class="terrain tile-four" src={groundGrass} alt="" />
			<Image class="terrain tile-five" src={groundGrass} alt="" />
			<Image class="terrain tile-six" src={groundGrass} alt="" />
			<Image class="terrain tile-seven" src={groundGrass} alt="" />
			<Image class="terrain tile-eight" src={groundGrass} alt="" />

			<div class="landmark apartments-landmark">
				<Image class="prop landmark-building" src={miiApartments} alt="" />
				<span>Mii Apartments</span>
			</div>
			<div class="landmark town-hall-landmark">
				<Image class="prop landmark-building" src={townHall} alt="" />
				<span>Town Hall</span>
			</div>
			<div class="landmark concert-hall-landmark">
				<Image class="prop landmark-building" src={concertHall} alt="" />
				<span>Concert Hall</span>
			</div>
			<div class="fountain-landmark">
				<div class="fountain-water"></div>
				<span>Fountain</span>
			</div>
			<Image class="prop palm-asset" src={palm} alt="" />
			<Image class="prop oak-asset" src={oak} alt="" />
			<Image class="prop bush-one" src={bush} alt="" />
			<Image class="prop bush-two" src={bush} alt="" />
			<Image class="prop rock-one" src={rock} alt="" />
			<Image class="prop sign-asset" src={sign} alt="" />
			<Image class="prop flower-yellow" src={flowerYellow} alt="" />
			<Image class="prop flower-red" src={flowerRed} alt="" />
		</div>

		<div class="resident">
			<div class="resident-photo">
				<Image
					src={profilePhoto}
					alt="Vishwas's current profile character"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
			<div class="speech-bubble">
				<p>Welcome to Vishwas Island.</p>
				<span>My music and watch history are broadcasting live below.</span>
			</div>
		</div>
	</div>

	<div class="mobile-intro">
		<h2>Welcome to Vishwas Island.</h2>
		<p>My music and watch history are broadcasting live below.</p>
	</div>

	<nav class="island-directory" aria-label="Vishwas Island locations">
		<span class="directory-label">Choose a destination</span>
		<a href="#listening-tile"><span aria-hidden="true">♪</span><strong>Concert Hall</strong><small>Now playing</small></a>
		<a href="#media-tile"><span aria-hidden="true">▣</span><strong>Mii News</strong><small>Recently watched</small></a>
	</nav>

	<nav class="social-links" aria-label="Vishwas online">
		<a href="https://realdishwash.github.io/resume/Vishwas_Parpattegar_24766178_Resume.pdf" target="_blank" rel="noreferrer">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M6 2a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8.8L14.2 2H6Zm7 1.7 4.3 4.3H13V3.7ZM9 11h6a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2Zm0 4h6a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2Z"></path>
			</svg>
			<span>Resume</span>
		</a>
		<a href="https://github.com/RealDishwash" target="_blank" rel="noreferrer">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d={githubPath}></path></svg>
			<span>GitHub</span>
		</a>
		<a href="https://www.linkedin.com/in/vishwasparpattegar" target="_blank" rel="noreferrer">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.68H9.35V9h3.42v1.56h.04c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77A1.75 1.75 0 0 0 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45A1.75 1.75 0 0 0 24 22.27V1.73A1.75 1.75 0 0 0 22.22 0h.01Z"></path>
			</svg>
			<span>LinkedIn</span>
		</a>
	</nav>
</section>

<style>
	.island-hero { position: relative; }

	.island-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		position: relative;
		z-index: 8;
	}

	.name-plaque,
	.social-links a {
		border: 2px solid rgb(116 79 35 / 22%);
		background: linear-gradient(180deg, #fff9df, #f7e7b9);
		box-shadow: 0 5px 0 rgb(110 72 30 / 16%), 0 10px 20px rgb(32 85 108 / 12%);
	}

	.name-plaque {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.68rem 1rem;
		border-radius: 1rem;
	}

	.plaque-icon {
		display: grid;
		place-items: center;
		width: 1.7rem;
		height: 1.7rem;
		border: 0.28rem solid #67c7b7;
		border-radius: 50%;
		font-size: 0.5rem;
		color: #fff9df;
		background: #ef735f;
	}

	h1 {
		margin: 0;
		font-family: 'Trebuchet MS', 'Arial Rounded MT Bold', sans-serif;
		font-size: clamp(1.15rem, 2.1vw, 1.65rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: #183452;
	}

	.name-plaque p {
		margin: 0.18rem 0 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #3a7583;
	}

	.social-links {
		display: flex;
		gap: 0.58rem;
		position: absolute;
		top: 0;
		right: 0;
		z-index: 12;
	}

	.social-links a {
		min-width: 4.6rem;
		min-height: 3.65rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.24rem;
		border-radius: 0.9rem;
		font-size: 0.68rem;
		font-weight: 700;
		color: #183452;
		transition: transform 160ms ease, filter 160ms ease;
	}

	.social-links a:hover { transform: translateY(-2px); filter: brightness(1.04); }
	.social-links svg { width: 1.25rem; height: 1.25rem; fill: currentColor; }

	.island-scene {
		height: clamp(430px, 49vw, 570px);
		margin-top: -2.1rem;
		position: relative;
		overflow: hidden;
	}

	.sky-asset {
		position: absolute;
		height: auto;
		pointer-events: none;
		user-select: none;
	}

	.sun-asset { width: 5.6rem; top: 12%; right: 13%; }
	.cloud-large { width: 9.5rem; top: 18%; left: 3%; opacity: 0.92; }
	.cloud-small { width: 7rem; top: 31%; right: 1%; opacity: 0.72; }

	.island-map {
		position: absolute;
		left: 50%;
		bottom: -0.4rem;
		width: 760px;
		height: 390px;
		transform: translateX(-50%);
		transform-origin: center bottom;
	}

	.island-shadow {
		position: absolute;
		left: 11%;
		bottom: 4%;
		width: 78%;
		height: 22%;
		border-radius: 50%;
		background: rgb(11 91 126 / 24%);
		filter: blur(12px);
	}

	.terrain,
	.prop {
		position: absolute;
		height: auto;
		filter: drop-shadow(0 9px 7px rgb(24 84 90 / 16%));
		user-select: none;
	}

	.terrain { width: 220px; z-index: 1; }
	.tile-one { left: 270px; top: 74px; }
	.tile-two { left: 165px; top: 126px; }
	.tile-three { left: 375px; top: 126px; }
	.tile-four { left: 60px; top: 178px; }
	.tile-five { left: 270px; top: 178px; }
	.tile-six { left: 480px; top: 178px; }
	.tile-seven { left: 165px; top: 230px; }
	.tile-eight { left: 375px; top: 230px; }

	.landmark {
		position: absolute;
		z-index: 6;
		width: 132px;
		text-align: center;
	}

	.landmark-building {
		position: relative;
		width: 114px;
		filter: drop-shadow(0 9px 7px rgb(24 84 90 / 18%));
	}

	.landmark span,
	.fountain-landmark span {
		display: block;
		width: fit-content;
		margin: -0.1rem auto 0;
		padding: 0.22rem 0.48rem;
		border: 1px solid rgb(80 78 59 / 24%);
		border-radius: 0.35rem;
		background: rgb(255 253 238 / 94%);
		box-shadow: 0 2px 0 rgb(78 56 33 / 14%);
		font-size: 0.62rem;
		font-weight: 700;
		line-height: 1;
		color: #334d61;
		white-space: nowrap;
	}

	.apartments-landmark { left: 84px; top: 76px; }
	.apartments-landmark .landmark-building { width: 126px; }
	.town-hall-landmark { left: 246px; top: 151px; }
	.concert-hall-landmark { right: 78px; top: 127px; }

	.fountain-landmark {
		position: absolute;
		left: 413px;
		top: 188px;
		z-index: 7;
		width: 78px;
		text-align: center;
	}

	.fountain-water {
		width: 56px;
		height: 28px;
		margin-inline: auto;
		border: 6px solid #f5edcd;
		border-radius: 50%;
		background: radial-gradient(circle at 50% 45%, #f7fbef 0 9%, #70d8de 11% 46%, #289eb5 48% 100%);
		box-shadow: 0 5px 0 rgb(51 103 107 / 20%);
	}

	.fountain-water::before {
		content: '';
		display: block;
		width: 7px;
		height: 23px;
		margin: -17px auto 0;
		border-radius: 999px 999px 0 0;
		background: #b9f3ed;
	}

	.palm-asset { width: 145px; right: 58px; top: 50px; z-index: 4; }
	.oak-asset { width: 110px; left: 40px; top: 135px; z-index: 5; }
	.bush-one { width: 65px; left: 258px; top: 155px; z-index: 5; }
	.bush-two { width: 54px; right: 188px; top: 198px; z-index: 6; }
	.rock-one { width: 96px; right: 32px; top: 243px; z-index: 7; }
	.sign-asset { width: 39px; right: 245px; top: 134px; z-index: 5; }
	.flower-yellow { width: 32px; left: 187px; top: 236px; z-index: 7; }
	.flower-red { width: 24px; right: 172px; top: 243px; z-index: 7; }

	.resident {
		position: absolute;
		left: 50%;
		bottom: 6.7rem;
		transform: translateX(-50%);
		z-index: 9;
	}

	.resident-photo {
		width: clamp(176px, 22vw, 244px);
		aspect-ratio: 1;
		border-radius: 50%;
		background: linear-gradient(180deg, #c8f3ef, #7dd5d6);
		border: 0.55rem solid #fff8d9;
		box-shadow: 0 0 0 3px rgb(50 113 125 / 30%), 0 1.25rem 1.5rem rgb(35 76 63 / 28%);
		overflow: hidden;
	}

	.resident-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	.speech-bubble {
		position: absolute;
		left: calc(100% + 1.5rem);
		top: 18%;
		width: clamp(210px, 25vw, 290px);
		padding: 1rem 1.15rem;
		border: 2px solid rgb(116 79 35 / 20%);
		border-radius: 1.35rem;
		background: #fff9e5;
		box-shadow: 0 8px 0 rgb(108 74 35 / 13%);
	}

	.speech-bubble::before {
		content: '';
		position: absolute;
		left: -0.8rem;
		bottom: 1.2rem;
		width: 1.5rem;
		height: 1.5rem;
		background: #fff9e5;
		border-left: 2px solid rgb(116 79 35 / 20%);
		border-bottom: 2px solid rgb(116 79 35 / 20%);
		transform: rotate(45deg);
	}

	.speech-bubble p {
		margin: 0;
		font-family: 'Trebuchet MS', 'Arial Rounded MT Bold', sans-serif;
		font-size: clamp(1rem, 1.6vw, 1.25rem);
		font-weight: 700;
		color: #183452;
	}

	.speech-bubble span {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.82rem;
		line-height: 1.4;
		color: #4a6275;
	}

	.mobile-intro { display: none; }

	.island-directory {
		display: grid;
		grid-template-columns: auto repeat(2, minmax(0, 1fr));
		align-items: center;
		gap: 0.65rem;
		position: relative;
		z-index: 10;
		width: min(720px, 100%);
		margin: -1.2rem auto 0;
		padding: 0.65rem;
		border: 2px solid rgb(116 79 35 / 20%);
		border-radius: 1.2rem;
		background: rgb(255 249 229 / 90%);
		box-shadow: 0 6px 0 rgb(108 74 35 / 13%);
		backdrop-filter: blur(8px);
	}

	.directory-label {
		padding-inline: 0.45rem;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #527184;
	}

	.island-directory a {
		display: grid;
		grid-template-columns: 2.1rem minmax(0, 1fr);
		grid-template-rows: auto auto;
		column-gap: 0.55rem;
		align-items: center;
		min-width: 0;
		padding: 0.58rem 0.65rem;
		border-radius: 0.75rem;
		background: #fffdf1;
		color: #29495e;
	}

	.island-directory a { transition: transform 150ms ease, background 150ms ease; }
	.island-directory a:hover { transform: translateY(-2px); background: #fff4ca; }

	.island-directory a > span {
		grid-row: 1 / 3;
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		background: #6acabb;
		font-size: 1rem;
		color: white;
	}

	.island-directory a:nth-child(2) > span { background: #ef735f; }
	.island-directory a:nth-child(3) > span { background: #5c8edc; }
	.island-directory strong { font-size: 0.76rem; line-height: 1.1; }
	.island-directory small { margin-top: 0.16rem; font-size: 0.63rem; color: #668092; }

	@media (max-width: 880px) {
		.island-scene { margin-top: -0.6rem; }
		.island-map { transform: translateX(-50%) scale(0.86); }
		.speech-bubble { left: 76%; top: 22%; }
		.island-directory { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.directory-label { grid-column: 1 / -1; text-align: center; }
	}

	@media (max-width: 780px) {
		.island-header { align-items: center; }

		.social-links {
			position: static;
			width: 100%;
			margin-top: 0.75rem;
			padding: 0.45rem;
			justify-content: space-around;
			border: 2px solid rgb(116 79 35 / 22%);
			border-radius: 1.15rem;
			background: rgb(255 248 221 / 96%);
			box-shadow: 0 6px 0 rgb(110 72 30 / 15%), 0 12px 28px rgb(31 79 102 / 24%);
		}

		.social-links a {
			min-width: 4.7rem;
			min-height: 3.55rem;
			border: 0;
			box-shadow: none;
			background: transparent;
		}

		.island-scene { height: 390px; }
		.island-map { bottom: -2.3rem; transform: translateX(-50%) scale(0.78); }
		.resident { bottom: 5.8rem; }
		.speech-bubble { display: none; }
		.island-directory { margin-top: -0.5rem; }
		.landmark span,
		.fountain-landmark span { display: none; }
	}

	@media (max-width: 460px) {
		.island-header { padding: 0.65rem 0.65rem 0; }
		.name-plaque { width: 100%; padding: 0.55rem 0.75rem; }
		.plaque-icon { font-size: 1.1rem; }
		.name-plaque p { display: none; }

		.island-scene {
			height: 280px;
			margin-top: 0;
			border-radius: 0 0 2.5rem 2.5rem;
			overflow: hidden;
		}

		.sun-asset { width: 3rem; top: 8%; right: 6%; }
		.cloud-large { width: 5.5rem; top: 15%; left: -0.7rem; }
		.cloud-small { display: none; }
		.island-map { bottom: -5.3rem; transform: translateX(-50%) scale(0.58); }
		.resident { bottom: 1.35rem; }
		.resident-photo { width: 126px; border-width: 0.4rem; }

		.mobile-intro {
			display: block;
			position: relative;
			z-index: 6;
			width: calc(100% - 1.3rem);
			margin: -1.4rem auto 0;
			padding: 1.65rem 1rem 1rem;
			border: 2px solid rgb(116 79 35 / 20%);
			border-radius: 1.25rem;
			background: #fff9e5;
			box-shadow: 0 6px 0 rgb(108 74 35 / 13%);
			text-align: center;
		}

		.mobile-intro h2 { margin: 0; font-size: 1.12rem; color: #183452; }
		.mobile-intro p { margin: 0.35rem auto 0; font-size: 0.8rem; line-height: 1.4; color: #4a6275; }

		.island-directory {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			margin: 0.7rem 0.65rem 0;
			width: auto;
		}

		.directory-label { display: none; }
		.island-directory a { padding: 0.5rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.social-links a { transition: none; }
	}
</style>
