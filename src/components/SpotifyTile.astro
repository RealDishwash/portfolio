---
import '../styles/media-card.css';

interface Props {
  spotifyPath: string;
}

const { spotifyPath } = Astro.props;
---

<article class="tile spotify" id="spotify-tile">
  <div class="spotify-head">
    <h2>Now Playing</h2>
    <span class="spotify-state" id="spotify-state">Loading</span>
  </div>
  <div class="spotify-body">
    <a
      class="spotify-art-link"
      data-spotify-link
      href="https://open.spotify.com"
      target="_blank"
      rel="noreferrer"
      aria-label="Open on Spotify"
    >
      <img
        id="spotify-art"
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
        alt="Album art"
        loading="lazy"
        decoding="async"
      />
    </a>
    <div class="spotify-info">
      <div class="spotify-meta" aria-live="polite">
        <a
          class="spotify-title"
          id="spotify-track-title"
          data-spotify-link
          href="https://open.spotify.com"
          target="_blank"
          rel="noreferrer"
        >
          Checking Spotify...
        </a>
        <p class="spotify-artists" id="spotify-artists">Fetching your listening status.</p>
      </div>
      <div class="player-progress" aria-hidden="true">
        <span class="player-time" id="spotify-time-current">-:--</span>
        <div class="player-track-bar">
          <span class="player-track-fill" id="spotify-progress-fill"></span>
        </div>
        <span class="player-time player-time-duration" id="spotify-time-duration">-:--</span>
      </div>
      <div class="player-controls" aria-hidden="true">
        <span class="player-control">
          <svg viewBox="0 0 24 24"><path d="M7 6h2v12H7V6Zm12 0v12l-9-6 9-6Z"></path></svg>
        </span>
        <span class="player-control player-control-main">
          <svg class="player-icon-play" viewBox="0 0 24 24"><path d="M9 6v12l9.5-6L9 6Z"></path></svg>
          <svg class="player-icon-pause" viewBox="0 0 24 24"><path d="M8 6h3v12H8V6Zm5 0h3v12h-3V6Z"></path></svg>
        </span>
        <span class="player-control">
          <svg viewBox="0 0 24 24"><path d="M15 6h2v12h-2V6ZM5 6l9 6-9 6V6Z"></path></svg>
        </span>
      </div>
    </div>
  </div>
  <span class="spotify-corner-link" aria-hidden="true">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d={spotifyPath} fill="currentColor"></path>
    </svg>
  </span>
</article>

<script>
	type SpotifyNowPlayingPayload = {
		isPlaying: boolean;
		trackName: string;
		artists: string;
		albumName?: string;
		albumImageUrl?: string;
		trackUrl?: string;
		progressMs?: number | null;
		durationMs?: number | null;
		lastUpdated?: string;
	};

	type SpotifyViewState = {
		spotifyState: 'loading' | 'error' | 'playing' | 'idle';
		stateLabel: string;
		trackTitle: string;
		trackArtists: string;
		imageUrl: string;
		trackUrl: string;
		isPlaying: boolean;
		progressMs: number | null;
		durationMs: number | null;
	};

	const DEFAULT_TRACK_URL = 'https://open.spotify.com';
	const POLL_INTERVAL_MS = 15_000;
	const PROGRESS_TICK_MS = 1_000;
	const MAX_CACHE_AGE_MS = 60_000;
	const ENDPOINT = '/api/spotify-now-playing';
	const PLACEHOLDER_ART = `data:image/svg+xml,${encodeURIComponent(
		"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#131b26'/><stop offset='1' stop-color='#0c121a'/></linearGradient></defs><rect width='64' height='64' fill='url(#g)'/><circle cx='32' cy='32' r='15' fill='none' stroke='#2f3a4b' stroke-width='2'/><circle cx='32' cy='32' r='2.8' fill='#2f3a4b'/></svg>"
	)}`;

	const tileNode = document.querySelector<HTMLElement>('#spotify-tile');
	const stateNode = document.querySelector<HTMLElement>('#spotify-state');
	const titleNode = document.querySelector<HTMLElement>('#spotify-track-title');
	const artistsNode = document.querySelector<HTMLElement>('#spotify-artists');
	const metaNode = document.querySelector<HTMLElement>('#spotify-tile .spotify-meta');
	const artNode = document.querySelector<HTMLImageElement>('#spotify-art');
	const timeCurrentNode = document.querySelector<HTMLElement>('#spotify-time-current');
	const timeDurationNode = document.querySelector<HTMLElement>('#spotify-time-duration');
	const progressFillNode = document.querySelector<HTMLElement>('#spotify-progress-fill');
	const linkNodes = Array.from(
		document.querySelectorAll<HTMLAnchorElement>('[data-spotify-link]')
	);

	if (
		tileNode &&
		stateNode &&
		titleNode &&
		artistsNode &&
		metaNode &&
		artNode &&
		timeCurrentNode &&
		timeDurationNode &&
		progressFillNode &&
		linkNodes.length
	) {
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const applyLink = (url: string) => {
			for (const node of linkNodes) {
				node.href = url;
			}
		};

		const clearMotionClasses = () => {
			artNode.classList.remove('is-swapping');
			metaNode.classList.remove('is-swapping');
		};

		const formatTime = (ms: number) => {
			const totalSeconds = Math.max(0, Math.floor(ms / 1000));
			const minutes = Math.floor(totalSeconds / 60);
			const seconds = totalSeconds % 60;
			return `${minutes}:${String(seconds).padStart(2, '0')}`;
		};

		// Progress is extrapolated locally between polls while a track plays.
		let progressBaseMs: number | null = null;
		let progressBaseAt = 0;
		let progressDurationMs: number | null = null;
		let progressPlaying = false;

		const renderProgress = () => {
			if (progressBaseMs === null || progressDurationMs === null || progressDurationMs <= 0) {
				timeCurrentNode.textContent = '-:--';
				timeDurationNode.textContent =
					progressDurationMs && progressDurationMs > 0 ? formatTime(progressDurationMs) : '-:--';
				progressFillNode.style.width = '0%';
				return;
			}

			const elapsed = progressPlaying ? Date.now() - progressBaseAt : 0;
			const shownMs = Math.min(progressBaseMs + elapsed, progressDurationMs);
			timeCurrentNode.textContent = formatTime(shownMs);
			timeDurationNode.textContent = formatTime(progressDurationMs);
			progressFillNode.style.width = `${(shownMs / progressDurationMs) * 100}%`;
		};

		const applyView = (viewState: SpotifyViewState) => {
			tileNode.dataset.spotifyState = viewState.spotifyState;
			stateNode.textContent = viewState.stateLabel;
			titleNode.textContent = viewState.trackTitle;
			artistsNode.textContent = viewState.trackArtists;
			artNode.src = viewState.imageUrl;
			applyLink(viewState.trackUrl);

			progressBaseMs = viewState.progressMs;
			progressBaseAt = Date.now();
			progressDurationMs = viewState.durationMs;
			progressPlaying = viewState.isPlaying;
			renderProgress();
		};

		let lastViewState: SpotifyViewState | null = null;
		let swapTimeoutId: number | undefined;
		let motionResetTimeoutId: number | undefined;

		const setViewState = (nextViewState: SpotifyViewState) => {
			const hasPrevious = Boolean(lastViewState);
			const stateChanged = lastViewState?.stateLabel !== nextViewState.stateLabel;
			const textChanged =
				lastViewState?.trackTitle !== nextViewState.trackTitle ||
				lastViewState?.trackArtists !== nextViewState.trackArtists;
			const artChanged = lastViewState?.imageUrl !== nextViewState.imageUrl;
			const shouldAnimate =
				hasPrevious && !prefersReducedMotion && (stateChanged || textChanged || artChanged);

			window.clearTimeout(swapTimeoutId);
			window.clearTimeout(motionResetTimeoutId);
			stateNode.classList.remove('is-state-bump');
			clearMotionClasses();

			if (!shouldAnimate) {
				applyView(nextViewState);
				lastViewState = nextViewState;
				return;
			}

			if (stateChanged) {
				stateNode.classList.add('is-state-bump');
			}
			if (artChanged) {
				artNode.classList.add('is-swapping');
			}
			if (textChanged) {
				metaNode.classList.add('is-swapping');
			}

			swapTimeoutId = window.setTimeout(() => {
				applyView(nextViewState);
				motionResetTimeoutId = window.setTimeout(() => {
					stateNode.classList.remove('is-state-bump');
					clearMotionClasses();
				}, 130);
			}, 110);

			lastViewState = nextViewState;
		};

		const setLoading = () => {
			setViewState({
				spotifyState: 'loading',
				stateLabel: 'Loading',
				trackTitle: 'Checking Spotify...',
				trackArtists: 'Fetching your listening status.',
				imageUrl: PLACEHOLDER_ART,
				trackUrl: DEFAULT_TRACK_URL,
				isPlaying: false,
				progressMs: null,
				durationMs: null,
			});
		};

		const setError = () => {
			setViewState({
				spotifyState: 'error',
				stateLabel: 'Unavailable',
				trackTitle: 'Spotify unavailable',
				trackArtists: 'Unable to load listening status right now.',
				imageUrl: PLACEHOLDER_ART,
				trackUrl: DEFAULT_TRACK_URL,
				isPlaying: false,
				progressMs: null,
				durationMs: null,
			});
		};

		const setNowPlaying = (payload: SpotifyNowPlayingPayload) => {
			const artistsAndAlbum = payload.albumName
				? `${payload.artists} • ${payload.albumName}`
				: payload.artists;

			// The endpoint is edge-cached, so account for the payload's age when playing.
			let progressMs = typeof payload.progressMs === 'number' ? payload.progressMs : null;
			if (progressMs !== null && payload.isPlaying && payload.lastUpdated) {
				const payloadAgeMs = Date.now() - Date.parse(payload.lastUpdated);
				if (Number.isFinite(payloadAgeMs) && payloadAgeMs > 0) {
					progressMs += Math.min(payloadAgeMs, MAX_CACHE_AGE_MS);
				}
			}

			setViewState({
				spotifyState: payload.isPlaying ? 'playing' : 'idle',
				stateLabel: payload.isPlaying ? 'Live' : 'Last played',
				trackTitle: payload.trackName || 'Unknown track',
				trackArtists: artistsAndAlbum || 'Unknown artist',
				imageUrl: payload.albumImageUrl || PLACEHOLDER_ART,
				trackUrl: payload.trackUrl || DEFAULT_TRACK_URL,
				isPlaying: payload.isPlaying,
				progressMs,
				durationMs: typeof payload.durationMs === 'number' ? payload.durationMs : null,
			});
		};

		let isRequestInFlight = false;

		const loadNowPlaying = async () => {
			if (isRequestInFlight) return;
			isRequestInFlight = true;

			try {
				const response = await fetch(ENDPOINT, { headers: { Accept: 'application/json' } });
				if (!response.ok) throw new Error('spotify request failed');
				const payload = (await response.json()) as SpotifyNowPlayingPayload;
				if (!payload || !payload.trackName || !payload.artists) throw new Error('invalid payload');
				setNowPlaying(payload);
			} catch {
				setError();
			} finally {
				isRequestInFlight = false;
			}
		};

		setLoading();
		void loadNowPlaying();
		window.setInterval(() => {
			void loadNowPlaying();
		}, POLL_INTERVAL_MS);
		window.setInterval(renderProgress, PROGRESS_TICK_MS);
	}
</script>

<style>
	.spotify-info {
		min-width: 0;
	}

	.player-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.15rem;
		margin-top: 0.55rem;
		color: var(--text-soft);
	}

	.player-control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.player-control svg {
		width: 0.95rem;
		height: 0.95rem;
		display: block;
		fill: currentColor;
	}

	.player-control-main {
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 999px;
		background: var(--text);
		color: var(--tile-strong);
	}

	.player-control-main svg {
		width: 0.85rem;
		height: 0.85rem;
	}

	/* Swap the main button glyph with the playback state. */
	.spotify[data-spotify-state='playing'] .player-icon-play {
		display: none;
	}

	.spotify:not([data-spotify-state='playing']) .player-icon-pause {
		display: none;
	}

</style>
