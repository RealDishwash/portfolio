		transform: translateY(0.13em);
		animation: terminalCursorBlink 1s step-end infinite;
		will-change: opacity;
	}

	@keyframes terminalCursorBlink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.terminal-cursor {
			animation: none;
		}
	}
</style>
