<article class="tile terminal" id="terminal-tile">
  <div class="terminal-chrome" aria-hidden="true">
    <span class="terminal-chrome-spacer"></span>
    <p class="terminal-caption">fish - 80x24</p>
    <div class="terminal-controls">
      <span class="terminal-control">&minus;</span>
      <span class="terminal-control">&#9633;</span>
      <span class="terminal-control">&#10005;</span>
    </div>
  </div>
  <div class="terminal-scroll">
    <div class="terminal-output" id="terminal-output" aria-live="polite">
      <p class="terminal-line terminal-line-muted">Last login: today on pts/0</p>
      <p class="terminal-line terminal-line-muted">Type <span class="terminal-kbd">help</span> and press enter.</p>
    </div>
  </div>
  <form class="terminal-prompt" id="terminal-form" autocomplete="off">
    <label class="terminal-line" for="terminal-input">
      <span class="terminal-user">vishwas@omnibook</span>
      <span class="terminal-path">~</span>
      <span class="terminal-symbol">&gt;</span>
      <input
        class="terminal-input"
        id="terminal-input"
        name="command"
        type="text"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        aria-label="Terminal command input"
        placeholder="help"
      />
    </label>
  </form>
</article>

<script>
	const tileNode = document.querySelector<HTMLElement>('#terminal-tile');
	const outputNode = document.querySelector<HTMLElement>('#terminal-output');
	const formNode = document.querySelector<HTMLFormElement>('#terminal-form');
	const inputNode = document.querySelector<HTMLInputElement>('#terminal-input');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (tileNode && outputNode && formNode && inputNode) {
		// Read another tile's live DOM so the terminal can report current state.
		const readText = (selector: string) => document.querySelector(selector)?.textContent?.trim() ?? '';

		// Keep the scrollback bounded so a long session can't grow the DOM forever.
		const MAX_ROWS = 60;
		const trimOutput = () => {
			while (outputNode.childElementCount > MAX_ROWS) {
				outputNode.firstElementChild?.remove();
			}
		};

		type Line = { text: string; tone?: 'muted' | 'accent' | 'success'; href?: string };

		const print = (lines: Line[]) => {
			for (const line of lines) {
				const row = document.createElement('p');
				row.className = 'terminal-line term-row';
				if (line.tone) row.classList.add(`term-${line.tone}`);
				if (line.href) {
					const anchor = document.createElement('a');
					anchor.className = 'term-link';
					anchor.href = line.href;
					anchor.target = '_blank';
					anchor.rel = 'noreferrer';
					anchor.textContent = line.text;
					row.append(anchor);
				} else {
					row.textContent = line.text;
				}
				outputNode.append(row);
			}
			trimOutput();
		};

		const echo = (command: string) => {
			const row = document.createElement('p');
			row.className = 'terminal-line term-row term-echo';
			const user = document.createElement('span');
			user.className = 'terminal-user';
			user.textContent = 'vishwas@omnibook';
			const path = document.createElement('span');
			path.className = 'terminal-path';
			path.textContent = '~';
			const symbol = document.createElement('span');
			symbol.className = 'terminal-symbol';
			symbol.textContent = '>';
			const cmd = document.createElement('span');
			cmd.className = 'term-echo-cmd';
			cmd.textContent = command;
			row.append(user, path, symbol, cmd);
			outputNode.append(row);
			trimOutput();
			return row;
		};

		const COMMANDS: Record<string, () => Line[]> = {
			help: () => [
				{ text: 'Available commands:', tone: 'muted' },
				{ text: 'whoami    — who is this' },
				{ text: 'projects  — what I build' },
				{ text: 'stack     — tools I use' },
				{ text: 'social    — find me online' },
				{ text: 'now       — what I am listening to' },
				{ text: 'sports    — live scores' },
				{ text: 'weather   — conditions in Sydney' },
				{ text: 'date      — current time (Sydney)' },
				{ text: 'clear     — clear the screen' },
			],
			whoami: () => [
				{ text: 'Vishwas Parpattegar' },
				{
					text: 'Software Engineering student @ UTS — CI/CD pipelines, container platforms, and self-hosted infrastructure.',
					tone: 'muted',
				},
			],
			projects: () => [
				{ text: 'homelab — TrueNAS RAIDZ1 array, Immich, Docker services.' },
				{ text: 'mapick  — Best-of-3 Valorant map veto tool.', href: 'https://mapick.vishy.org' },
			],
			stack: () => [
				{ text: 'Docker · TrueNAS · Kubernetes · Astro · Python · Fish' },
			],
			social: () => [
				{ text: 'github.com/RealDishwash', href: 'https://github.com/RealDishwash' },
				{ text: 'linkedin.com/in/vishwasparpattegar', href: 'https://www.linkedin.com/in/vishwasparpattegar' },
				{ text: 'trakt.tv/realdishwash', href: 'https://app.trakt.tv/profile/realdishwash' },
				{ text: 'resume.pdf', href: 'https://realdishwash.github.io/resume/Vishwas_Parpattegar_24766178_Resume.pdf' },
			],
			now: () => {
				const title = readText('#listening-track-title');
				const artists = readText('#listening-artists');
				const state = readText('#listening-state');
				if (!title || title.includes('...') || state === 'Unavailable') {
					return [{ text: 'Nothing playing right now.', tone: 'muted' }];
				}
				return [
					{ text: `♪ ${title}` },
					{ text: artists, tone: 'muted' },
				];
			},
			sports: () => {
				const lines: Line[] = [];
				const nbaAway = readText('#nba-away-name');
				const nbaHome = readText('#nba-home-name');
				if (nbaAway && nbaAway !== '—' && !nbaAway.startsWith('No ')) {
					const as = readText('#nba-away-score');
					const hs = readText('#nba-home-score');
					lines.push({ text: `NBA  ${nbaAway} ${as}  ·  ${nbaHome} ${hs}`.replace(/\s+/g, ' ').trim() });
				}
				const f1Title = readText('#f1-title');
				const f1Leader = document.querySelector('#f1-podium .ls-podium-name')?.textContent?.trim();
				if (f1Title && f1Title !== '—' && !f1Title.startsWith('No ')) {
					lines.push({ text: `F1   ${f1Title}${f1Leader ? ` — P1 ${f1Leader}` : ''}` });
				}
				return lines.length ? lines : [{ text: 'No live scores right now.', tone: 'muted' }];
			},
			weather: () => {
				const temp = readText('#weather-temp');
				const feels = readText('#weather-feels');
				const wind = readText('#weather-wind');
				if (!temp || temp.startsWith('--')) return [{ text: 'Weather unavailable.', tone: 'muted' }];
				return [{ text: `Sydney: ${temp} · ${feels} · ${wind}` }];
			},
			date: () => [
				{
					text: new Intl.DateTimeFormat('en-AU', {
						timeZone: 'Australia/Sydney',
						dateStyle: 'full',
						timeStyle: 'medium',
					}).format(new Date()),
				},
			],
		};

		// Bring the just-entered command to the top of the viewport so its output
		// reads top-to-bottom instead of the view jumping to the very bottom.
		const focusRow = (row: HTMLElement) => {
			const padTop = parseFloat(getComputedStyle(outputNode).paddingTop) || 0;
			outputNode.scrollTop = Math.max(0, row.offsetTop - padTop);
		};

		const run = (raw: string) => {
			const command = raw.trim();
			const echoRow = echo(command || '');

			if (command) {
				const name = command.split(/\s+/)[0].toLowerCase();
				if (name === 'clear') {
					outputNode.replaceChildren();
					return;
				} else if (name === 'sudo') {
					print([{ text: `${command.split(/\s+/)[1] ?? 'sudo'}: permission denied — nice try.`, tone: 'accent' }]);
				} else if (name === 'echo') {
					print([{ text: command.slice(4).trim() }]);
				} else {
					const handler = COMMANDS[name];
					print(
						handler ? handler() : [{ text: `command not found: ${name} — try 'help'`, tone: 'accent' }]
					);
				}
			}

			focusRow(echoRow);
		};

		// Command history navigable with the up/down arrows.
		const history: string[] = [];
		let historyIndex = 0;

		formNode.addEventListener('submit', (event) => {
			event.preventDefault();
			const value = inputNode.value;
			run(value);
			if (value.trim()) {
				history.push(value.trim());
				historyIndex = history.length;
			}
			inputNode.value = '';
		});

		inputNode.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowUp') {
				if (!history.length) return;
				event.preventDefault();
				historyIndex = Math.max(0, historyIndex - 1);
				inputNode.value = history[historyIndex] ?? '';
			} else if (event.key === 'ArrowDown') {
				if (!history.length) return;
				event.preventDefault();
				historyIndex = Math.min(history.length, historyIndex + 1);
				inputNode.value = history[historyIndex] ?? '';
			}
		});

		// Clicking anywhere on the tile focuses the prompt (unless selecting a link/text).
		tileNode.addEventListener('click', (event) => {
			const target = event.target as HTMLElement;
			if (target.closest('a') || window.getSelection()?.toString()) return;
			inputNode.focus();
		});

		// Idle typewriter cycles example commands through the placeholder until the
		// visitor interacts; it pauses while the input is focused or has text.
		const examples = ['help', 'whoami', 'projects', 'now', 'sports', 'stack'];
		let exampleIndex = 0;
		let charIndex = 0;
		let isDeleting = false;
		let typewriterId = 0;
		let interacted = false;

		const tick = () => {
			if (interacted) return;
			const word = examples[exampleIndex];
			charIndex += isDeleting ? -1 : 1;
			inputNode.placeholder = word.slice(0, charIndex);
			let delay = isDeleting ? 55 : 110;
			if (!isDeleting && charIndex === word.length) {
				delay = 1500;
				isDeleting = true;
			} else if (isDeleting && charIndex === 0) {
				delay = 320;
				isDeleting = false;
				exampleIndex = (exampleIndex + 1) % examples.length;
			}
			typewriterId = window.setTimeout(tick, delay);
		};

		const stopTypewriter = () => {
			interacted = true;
			window.clearTimeout(typewriterId);
			inputNode.placeholder = 'help';
		};

		inputNode.addEventListener('focus', stopTypewriter, { once: true });

		if (prefersReducedMotion) {
			inputNode.placeholder = 'help';
		} else {
			typewriterId = window.setTimeout(tick, 600);
		}

		window.addEventListener(
			'pagehide',
			() => {
				window.clearTimeout(typewriterId);
			},
			{ once: true }
		);
	}
</script>

<style>
	.terminal {
		padding: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		background: #11151d;
		height: 100%;
		/* Let the tile be shorter than its content so the output scrolls inside
		   rather than growing the whole grid row as commands accumulate. */
		min-height: 0;
		cursor: text;
	}

	.terminal::before {
		display: none;
	}

	.terminal:focus-within {
		border-color: color-mix(in srgb, var(--accent), var(--border) 38%);
	}

	.terminal-chrome {
		/* Equal flexible side columns keep the caption truly centered. */
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0.62rem;
		background: #1f2632;
		border-bottom: 1px solid #3a4352;
	}

	.terminal-caption {
		margin: 0;
		text-align: center;
		font-size: var(--label-xs);
		letter-spacing: 0.04em;
		color: var(--text-soft);
		font-family: var(--font-mono);
		opacity: 0.9;
	}

	.terminal-controls {
		justify-self: end;
		display: inline-flex;
		gap: 0.4rem;
	}

	.terminal-control {
		width: 1.05rem;
		height: 1.05rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: #2a3342;
		color: var(--text-soft);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		line-height: 1;
	}

	/* The scroll area flexes to the height the sibling tile sets for the row; its
	   only child is absolutely positioned so the growing output never feeds back
	   into the grid row's intrinsic height. */
	.terminal-scroll {
		position: relative;
		flex: 1 1 0;
		min-height: 0;
	}

	.terminal-output {
		position: absolute;
		inset: 0;
		padding: 0.8rem 0.85rem 0.4rem;
		/* Always show the scrollbar so it's clear the history scrolls. */
		overflow-y: scroll;
		background: #0c1118;
		scrollbar-width: thin;
		scrollbar-color: #46546a #161c26;
	}

	.terminal-output::-webkit-scrollbar {
		width: 10px;
	}

	.terminal-output::-webkit-scrollbar-track {
		background: #161c26;
		border-radius: 999px;
	}

	.terminal-output::-webkit-scrollbar-thumb {
		background: #46546a;
		border-radius: 999px;
		border: 2px solid #161c26;
	}

	.terminal-output::-webkit-scrollbar-thumb:hover {
		background: #586a85;
	}

	.terminal-line {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--text-soft);
		font-family: var(--font-mono);
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.42rem;
	}

	.terminal-line + .terminal-line {
		margin-top: 0.32rem;
	}

	.terminal-line-muted {
		color: var(--muted);
		font-size: var(--text-xs);
		letter-spacing: 0.01em;
	}

	.terminal-kbd {
		font-family: var(--font-mono);
		color: var(--text);
		background: #1b222e;
		border: 1px solid #2f3a4b;
		border-radius: var(--radius-xs);
		padding: 0 0.3em;
	}

	.terminal-user {
		color: #90b4ff;
	}

	.terminal-path {
		color: color-mix(in srgb, var(--success), white 20%);
	}

	.terminal-symbol {
		color: var(--accent-soft);
	}

	.terminal-prompt {
		padding: 0.1rem 0.85rem 0.85rem;
		background: #0c1118;
	}

	.terminal-prompt .terminal-line {
		margin: 0;
		cursor: text;
		flex-wrap: nowrap;
	}

	.terminal-input {
		flex: 1;
		min-width: 0;
		border: 0;
		background: transparent;
		color: var(--text);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		line-height: 1.5;
		padding: 0;
		caret-color: var(--accent-soft);
	}

	.terminal-input:focus {
		outline: none;
	}

	.terminal-input::placeholder {
		color: var(--muted);
		opacity: 0.8;
	}

	/* Output rows are injected at runtime, so they don't carry Astro's scope
	   class — these selectors must be :global() to reach them. */
	.terminal-output :global(.term-row) {
		display: block;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		color: var(--text-soft);
	}

	.terminal-output :global(.term-muted) {
		color: var(--muted);
	}

	.terminal-output :global(.term-accent) {
		color: var(--accent-soft);
	}

	.terminal-output :global(.term-success) {
		color: color-mix(in srgb, var(--success), white 14%);
	}

	.terminal-output :global(.term-echo) {
		display: flex;
		gap: 0.42rem;
		margin-top: 0.5rem;
	}

	.terminal-output :global(.term-echo-cmd) {
		color: var(--text);
	}

	.terminal-output :global(.term-link) {
		color: #90b4ff;
		text-decoration: none;
	}

	.terminal-output :global(.term-link:hover) {
		text-decoration: underline;
	}

	/* When tiles stop sharing a row and size to content, give the scroll area a
	   definite height so it still has somewhere to scroll. */
	@media (max-width: 720px) {
		.terminal-scroll {
			flex: none;
			height: 15rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.terminal {
			scroll-behavior: auto;
		}
	}
</style>
