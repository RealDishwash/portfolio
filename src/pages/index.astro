---
import Layout from '../layouts/Layout.astro';
import HeroTile from '../components/HeroTile.astro';
import EngineeringSnapshotTile from '../components/EngineeringSnapshotTile.astro';
import CurrentConditionsTile from '../components/CurrentConditionsTile.astro';
import StatusTile from '../components/StatusTile.astro';
import SpotifyTile from '../components/SpotifyTile.astro';
import FeaturedMediaTile from '../components/FeaturedMediaTile.astro';
import TerminalTile from '../components/TerminalTile.astro';
import SignatureTile from '../components/SignatureTile.astro';
import profilePhoto from '../assets/profile-photo.png';
import {
	siAstro,
	siDocker,
	siFishshell,
	siGithub,
	siKubernetes,
	siPython,
	siSpotify,
	siTruenas,
	siThemoviedatabase,
} from 'simple-icons';

const tools = [
	{ name: 'Docker', iconPath: siDocker.path, url: 'https://www.docker.com/' },
	{ name: 'TrueNAS', iconPath: siTruenas.path, url: 'https://www.truenas.com/' },
	{ name: 'Kubernetes', iconPath: siKubernetes.path, url: 'https://kubernetes.io/' },
	{ name: 'Astro', iconPath: siAstro.path, url: 'https://astro.build/' },
	{ name: 'Python', iconPath: siPython.path, url: 'https://www.python.org/' },
	{ name: 'Fish', iconPath: siFishshell.path, url: 'https://fishshell.com/' },
];
---

<Layout title="Vishwas Parpattegar | Portfolio">
	<div class="backdrop" aria-hidden="true"></div>
	<main class="page">
		<HeroTile profilePhoto={profilePhoto} githubPath={siGithub.path} mediaPath={siThemoviedatabase.path} />

		<section class="cards">
			<EngineeringSnapshotTile tools={tools} />
			<CurrentConditionsTile />
			<StatusTile />
			<SpotifyTile spotifyPath={siSpotify.path} />
			<FeaturedMediaTile mediaPath={siThemoviedatabase.path} />
			<TerminalTile />
			<SignatureTile />
		</section>
	</main>
</Layout>

<script>
	const pageNode = document.querySelector<HTMLElement>('.page');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (pageNode && !prefersReducedMotion) {
		const introTiles = pageNode.querySelectorAll<HTMLElement>('.tile');
		const introDurationMs = 560;
		pageNode.classList.add('is-intro-active');
		let maxIntroDelayMs = 0;

		introTiles.forEach((tile, index) => {
			const delay = index * 60;
			maxIntroDelayMs = Math.max(maxIntroDelayMs, delay);
			tile.style.setProperty('--intro-delay', `${delay}ms`);
		});

		const introTimeoutId = window.setTimeout(() => {
			pageNode.classList.remove('is-intro-active');
		}, maxIntroDelayMs + introDurationMs + 90);

		window.addEventListener(
			'pagehide',
			() => {
				window.clearTimeout(introTimeoutId);
			},
			{ once: true }
		);
	}
</script>

<style is:global>
	.page {
		width: min(1120px, 100% - 1.5rem);
		margin: 1.25rem auto 2.5rem;
		position: relative;
		z-index: 2;
	}

	.backdrop {
		position: fixed;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
		isolation: isolate;
		background:
			radial-gradient(74% 58% at 12% -8%, rgb(255 95 86 / 20%), transparent 70%),
			radial-gradient(62% 48% at 88% 10%, rgb(39 201 63 / 12%), transparent 72%),
			radial-gradient(78% 56% at 50% 104%, rgb(140 164 196 / 11%), transparent 72%),
			linear-gradient(180deg, #0d141d 0%, #09111a 45%, #070b10 100%);
		z-index: 1;
	}

	.backdrop::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			repeating-linear-gradient(0deg, rgb(255 255 255 / 2%) 0 1px, transparent 1px 5px),
			repeating-linear-gradient(90deg, rgb(255 255 255 / 1.5%) 0 1px, transparent 1px 6px);
		opacity: 0.2;
	}

	.backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(130% 94% at 50% 18%, transparent 44%, rgb(2 5 9 / 54%) 100%);
	}

	.tile {
		background: linear-gradient(180deg, color-mix(in srgb, var(--tile), white 3%), var(--tile-alt));
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 1.15rem;
		position: relative;
		overflow: hidden;
		isolation: isolate;
		transition: border-color 0.2s ease;
	}

	.tile::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: color-mix(in srgb, var(--border), white 12%);
		opacity: 0.55;
		pointer-events: none;
	}

	.tile:hover {
		border-color: color-mix(in srgb, var(--accent), var(--border) 38%);
	}

	.page.is-intro-active .tile {
		opacity: 0;
		transform: translateY(42px);
		animation: tileRushIn 560ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
		animation-delay: var(--intro-delay, 0ms);
	}

	@keyframes tileRushIn {
		0% {
			opacity: 0;
			transform: translateY(42px);
		}
		72% {
			opacity: 1;
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	h2 {
		margin: 0;
		font-size: clamp(1.1rem, 1.3vw, 1.45rem);
		line-height: 1.25;
		font-weight: 600;
		font-family: var(--font-sans);
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.cards h2 {
		font-family: var(--font-mono);
		font-size: clamp(1.02rem, 1.1vw, 1.18rem);
		font-weight: 500;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	p,
	li {
		font-family: var(--font-sans);
		color: var(--text-soft);
		line-height: 1.5;
		font-size: var(--text-base);
		max-width: 52ch;
	}

	a:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--accent), white 25%);
		outline-offset: 2px;
	}

	.muted {
		color: var(--muted);
	}

	.cards {
		margin-top: 0.95rem;
		display: grid;
		gap: 0.95rem;
		grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
		grid-template-areas:
			'about meta'
			'about spotify'
			'now media'
			'terminal terminal'
			'signature signature';
		align-items: stretch;
	}

	.cards > .about {
		grid-area: about;
	}

	.cards > .meta {
		grid-area: meta;
	}

	.cards > .now-tile {
		grid-area: now;
	}

	.cards > .spotify {
		grid-area: spotify;
	}

	.cards > .media-tile {
		grid-area: media;
	}

	.cards > .signature {
		grid-area: signature;
	}

	.cards > .terminal {
		grid-area: terminal;
	}

	.cards > .tile {
		height: 100%;
	}

	@media (max-width: 860px) {
		.cards {
			grid-template-columns: 1fr;
			grid-template-areas:
				'about'
				'meta'
				'now'
				'spotify'
				'media'
				'terminal'
				'signature';
		}

		.cards > .tile {
			height: auto;
		}
	}

	@media (max-width: 760px) {
		.backdrop {
			background:
				radial-gradient(92% 58% at 0% -12%, rgb(255 95 86 / 17%), transparent 70%),
				radial-gradient(88% 52% at 100% 7%, rgb(39 201 63 / 10%), transparent 74%),
				radial-gradient(108% 66% at 50% 110%, rgb(140 164 196 / 9%), transparent 74%),
				linear-gradient(180deg, #0c121b 0%, #081018 48%, #070b10 100%);
		}

		.backdrop::before {
			opacity: 0.14;
		}
	}

	@media (max-width: 640px) {
		.page {
			width: min(1120px, 100% - 1rem);
			margin-top: 0.8rem;
		}

		.cards {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.page.is-intro-active .tile {
			animation: none;
			opacity: 1;
			transform: none;
		}

		.tile {
			transition: none;
		}
	}
</style>
