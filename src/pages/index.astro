---
import Layout from '../layouts/Layout.astro';
import HeroTile from '../components/HeroTile.astro';
import ListeningTile from '../components/ListeningTile.astro';
import RecentlyWatchedTile from '../components/RecentlyWatchedTile.astro';
import profilePhoto from '../assets/profile-photo.png';
import { siGithub, siLastdotfm, siTrakt } from 'simple-icons';
---

<Layout
	title="Vishwas Island"
	description="Vishwas Parpattegar's little corner of the internet — see what I'm listening to and watching lately."
>
	<main class="island-page">
		<HeroTile profilePhoto={profilePhoto} githubPath={siGithub.path} />

		<section class="broadcasts" aria-labelledby="broadcasts-title">
			<header class="broadcasts-header">
				<p>Live from the island</p>
				<h2 id="broadcasts-title">Two places worth checking in on.</h2>
			</header>
			<div class="media-grid">
				<ListeningTile lastFmPath={siLastdotfm.path} />
				<RecentlyWatchedTile mediaPath={siTrakt.path} />
			</div>
		</section>

		<footer>
			<p>Unofficial fan-made interface inspired by Tomodachi Life. Nintendo is not affiliated with this site.</p>
		</footer>
	</main>
</Layout>

<style is:global>
	body {
		min-width: 280px;
		min-height: 100vh;
		background:
			radial-gradient(circle at 12% 8%, rgb(255 255 255 / 84%) 0 2.8rem, transparent 2.9rem),
			radial-gradient(circle at 88% 16%, rgb(255 255 255 / 70%) 0 2.2rem, transparent 2.3rem),
			linear-gradient(180deg, #83d6f1 0%, #bcecf7 47%, #56bed7 47.2%, #1e93bd 100%);
		background-attachment: fixed;
		background-color: #1e93bd;
	}

	.island-page {
		width: min(1180px, calc(100% - 2rem));
		margin-inline: auto;
		padding: 1.25rem 0 2rem;
		position: relative;
	}

	.media-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.85rem, 2vw, 1.35rem);
		margin-top: 0;
		position: relative;
		z-index: 5;
	}

	.broadcasts {
		margin-top: clamp(1.4rem, 3vw, 2.4rem);
	}

	.broadcasts-header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.9rem;
		padding-inline: 0.2rem;
	}

	.broadcasts-header p {
		margin: 0;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #e7fcff;
	}

	.broadcasts-header h2 {
		margin: 0;
		font-family: 'Trebuchet MS', 'Arial Rounded MT Bold', sans-serif;
		font-size: clamp(1.1rem, 2.2vw, 1.55rem);
		color: #fffdf1;
		text-align: right;
	}

	footer {
		width: fit-content;
		margin: 1.4rem auto 0;
		padding: 0.62rem 1rem;
		border: 2px solid rgb(116 79 35 / 20%);
		border-radius: 999px;
		background: rgb(255 248 221 / 88%);
		box-shadow: 0 5px 0 rgb(110 72 30 / 13%);
	}

	footer p {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		color: #30455a;
		text-align: center;
	}

	@media (max-width: 780px) {
		.island-page {
			width: min(620px, calc(100% - 1.25rem));
			padding-top: 0.7rem;
			padding-bottom: 2rem;
		}

		.media-grid {
			grid-template-columns: 1fr;
		}

		.broadcasts { margin-top: 1.2rem; }
	}

	@media (max-width: 460px) {
		.island-page {
			width: 100%;
			padding-top: 0;
		}

		.media-grid {
			padding-inline: 0.65rem;
			gap: 0.78rem;
		}

		.broadcasts { margin-top: 1rem; }
		.broadcasts-header { display: block; padding-inline: 0.8rem; }
		.broadcasts-header h2 { margin-top: 0.18rem; text-align: left; font-size: 1.15rem; }

		footer { display: none; }
	}
</style>
